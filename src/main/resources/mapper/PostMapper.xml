<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.java.join.model.mapper.PostMapper">
    <insert id="insert" parameterType="kr.java.join.model.domain.Post">
        insert into post (info_id, title, content)
        values (#{infoId}, #{title}, #{content})
    </insert>
</mapper>